---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { pickFirstAvailableEntryImage } from "../lib/cover";

const RECENT_POSTS_LIMIT = 12;

const all = await getCollection("posts", ({ data }) => !data.draft);
const featured = all
  .filter((post) => post.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentPosts = posts.slice(0, RECENT_POSTS_LIMIT);
const homeOgImage = pickFirstAvailableEntryImage(featured.length ? featured : posts);
const fixedTagEntries = [
  {
    href: `/tag/${encodeURIComponent("独立开发者App")}`,
    title: "想找值得长期留下来的小产品，从这里进",
    description: "优先看那些用过之后，真的容易留下来的独立开发者产品。",
    image: "/indie.png"
  },
  {
    href: `/tag/${encodeURIComponent("平替软件")}`,
    title: "不想一上来就花钱，可以先看这些平替",
    description: "先找价格更轻、体验又没差太远的替代方案。",
    image: "/altertive.png"
  }
];
const priorityReads = [
  {
    href: "/article/betterstage-for-mac",
    title: "BetterStage：每次切项目都要重摆桌面，就先看这篇",
    note: "每天切多个项目，还在双屏来回摆窗",
    description: "重点不是分屏，而是切项目时能不能把那套工作区一起带回来。"
  },
  {
    href: "/article/cc-switch-for-mac",
    title: "CC Switch：Claude Code、Codex 来回切久了，很需要这种统一入口",
    note: "已经在多套 CLI 和多家供应商之间切换",
    description: "如果你已经混用多套 CLI 和多家供应商，这篇会很快说明统一管理为什么省事。"
  },
  {
    href: "/article/codexbar-for-mac",
    title: "CodexBar：如果你也总惦记 Token 还剩多少，这篇会很有代入感",
    note: "同时挂着多个 Agent 会话，总怕额度见底",
    description: "它解决的不是好不好看，而是任务跑着跑着总惦记额度的分心感。"
  },
  {
    href: "/article/vidhub-v-1-7-8",
    title: "VidHub：如果你受够了文件夹找片，这篇更容易看懂它的价值",
    note: "片源散在 NAS、本地硬盘和网盘里",
    description: "它最打动人的地方，不是功能多，而是看片这条路径终于没那么碎了。"
  }
];
const homeCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Mac 应用推荐与评测：效率工具、开发工具、工作流指南",
  description:
    "MacAppHQ 提供 Mac 应用评测、效率工具对比和工作流指南，覆盖开发、截图、窗口管理、剪贴板与 AI 工具等场景，帮助读者判断一款工具是否适合自己。",
  url: "https://www.macapphq.com/",
  inLanguage: "zh-CN",
  about: ["Mac 应用推荐", "Mac 效率工具", "Mac 开发工具", "工作流"],
  mainEntity: {
    "@type": "ItemList",
    itemListElement: recentPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `https://www.macapphq.com/article/${post.data.urlSlug}`,
      name: post.data.title
    }))
  }
};
---

<BaseLayout
  title="Mac 应用推荐与评测：效率工具、开发工具、工作流指南 | MacAppHQ"
  description="MacAppHQ 提供 Mac 应用评测、效率工具对比和工作流指南，覆盖开发、截图、窗口管理、剪贴板与 AI 工具等场景，帮助读者判断一款工具是否适合自己。"
  keywords="Mac应用推荐,Mac效率工具,macOS软件,独立开发者App,平替软件,工作流"
  canonical="https://www.macapphq.com/"
  image={homeOgImage || undefined}
  structuredData={homeCollectionSchema}
>
  <section class="glass partner-strip" aria-label="合作伙伴：数码荔枝">
    <a
      class="partner-strip__link"
      href="https://lizhi.shop/site/search_list/category_id/64?cid=j13endai&utm_medium=n649haxs"
      target="_blank"
      rel="sponsored noopener noreferrer"
    >
      <span class="partner-strip__icon">
        <img
          src="/media/partners/lizhi-icon.png"
          alt="数码荔枝"
          width="180"
          height="180"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="partner-strip__copy">
        <span class="partner-strip__title-row">
          <span class="partner-strip__label">合作伙伴</span>
          <strong>Mac 正版软件活动</strong>
        </span>
        <span class="partner-strip__subtitle">本月 Mac 软件促销，正版授权，售后有保障</span>
      </span>
      <span class="partner-strip__cta">
        查看活动
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </a>
  </section>

  {featured.length ? (
    <>
      <section class="featured-grid" aria-label="精选文章">
        <div class="featured-main">
          <div class="featured-main__row">
            {featured.slice(0, 2).map((post, index) => (
              <div class={`featured-main__item featured-main__item--${index + 1}`}>
                <PostCard post={post} showDescription={true} showMeta={false} showBadge={false} headingTag="h3" priority={index === 0} />
              </div>
            ))}
          </div>
          <div class="featured-main__row">
            {featured.slice(2, 4).map((post, index) => (
              <div class={`featured-main__item featured-main__item--${index + 3}`}>
                <PostCard post={post} showDescription={true} showMeta={false} showBadge={false} headingTag="h3" />
              </div>
            ))}
          </div>
        </div>
        <div class="featured-side">
          <div class="featured-side__top">
            {featured.slice(4, 5).map((post) => (
              <PostCard
                post={post}
                showDescription={true}
                showMeta={false}
                showBadge={false}
                headingTag="h3"
                compact={true}
              />
            ))}
          </div>
          <div class="featured-side__bottom">
            {fixedTagEntries.map((entry) => (
              <article class="card post-card topic-card topic-card--compact">
                <a class="post-card__link" href={entry.href} aria-label={entry.title} style="text-decoration:none;">
                  <div class="post-card__media has-img" aria-hidden="true">
                    <img class="post-card__img" src={entry.image} alt="" width="1500" height="630" loading="lazy" decoding="async" />
                  </div>
                  <div class="post-card__body">
                    <h3 class="post-card__title">{entry.title}</h3>
                    <p class="topic-card__desc">{entry.description}</p>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>
  ) : null}

  <div class="section-head">
    <h2>最近更新了什么？</h2>
    <div class="section-head__actions">
      <a class="section-more" href="/archive">
        全部文章
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
  <section class="grid" aria-label="最新文章">
    {recentPosts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>
  <div class="section-cta">
    <a class="section-cta__button" href="/category">查看全部</a>
  </div>

  <section class="glass category-featured-block" aria-label="Priority reads">
    <div class="section-head">
      <h2>第一次来，先看哪几篇？</h2>
    </div>
    <div class="search-results__list">
      {priorityReads.map((item) => (
        <a class="search-result" href={item.href}>
          <div class="search-result__meta">{item.note}</div>
          <div class="search-result__title">{item.title}</div>
          <p class="search-result__desc">{item.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
