---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import friendlinksData from "../data/friendlinks.json";

const pages = await getCollection("pages", ({ data }) => !data.draft);
const page = pages.find((p) => p.data.urlSlug === "links") ?? null;
const { Content } = page ? await render(page) : { Content: null };

const canonical = `https://www.macapphq.com/links`;
const links = (friendlinksData?.links ?? []) as Array<{
  name: string;
  url: string;
  description?: string;
}>;
---

<BaseLayout
  title={`${page?.data.title ?? "友链"} | MacAppHQ`}
  description={page?.data.description}
  canonical={canonical}
  robots="noindex,follow"
>
  <div class="wrap">
    <article class="glass links-page">
      <h1>{page?.data.title ?? "友链"}</h1>
      {Content ? <div class="links-page__intro"><Content /></div> : null}

      <h2>朋友们</h2>
      <div class="bf-grid">
        {links.map((item) => (
          <a
            class="card bf-card links-card"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            style="text-decoration: none;"
          >
            <h3 class="bf-card__name">{item.name}</h3>
            {item.description ? <p class="bf-card__desc">{item.description}</p> : null}
            <div class="bf-card__foot">
              <span>{new URL(item.url).host}</span>
              <span class="bf-dates">外部链接</span>
            </div>
          </a>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>
