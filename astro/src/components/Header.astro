---
const nav: { href: string; label: string; badge?: string }[] = [
  { href: "/", label: "首页" },
  { href: "/category", label: "分类" },
  { href: "/black-friday-2026", label: "2026 黑五", badge: "DEAL" },
  { href: "/search", label: "搜索" },
  { href: "/submit", label: "独立产品收录" },
  { href: "/about", label: "关于" }
];
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<header class="topbar">
  <div class="wrap">
    <div class="topbar-inner glass">
      {isHome ? (
        <h1 class="brand-heading">
          <a class="brand" href="/">
            <img class="brand-logo" src="/favicon.ico" alt="" width="18" height="18" decoding="async" aria-hidden="true" />
            <span class="brand-title">MacAppHQ</span>
            <span class="sr-only">：Mac 应用推荐与评测、效率工具与工作流指南</span>
          </a>
        </h1>
      ) : (
        <a class="brand" href="/">
          <img class="brand-logo" src="/favicon.ico" alt="" width="18" height="18" decoding="async" aria-hidden="true" />
          <span class="brand-title">MacAppHQ</span>
        </a>
      )}
      <nav class="nav" aria-label="Site">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              {
                "nav-link--badge": Boolean(item.badge),
                "is-active": Astro.url.pathname === item.href
              }
            ]}
            aria-current={Astro.url.pathname === item.href ? "page" : undefined}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {item.label}
            {item.badge ? <span class="nav-badge">{item.badge}</span> : null}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
