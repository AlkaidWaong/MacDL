---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  seoTitle?: string;
  description?: string;
  price?: string;
  platform?: string;
  lizhiUrl?: string;
  lizhiName?: string;
  sources?: Array<{ name: string; url: string; note?: string }>;
  quotes?: Array<{ text: string; source: string; url: string }>;
  officialUrl?: string;
  updatedAt?: Date;
  faqs?: Array<{ question: string; answer: string }>;
  date: Date;
  categories?: string[];
  tags?: string[];
  quickTake?: string;
  canonical?: string;
  image?: string;
  heroImage?: string;
  heroWidth?: number;
  heroHeight?: number;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Array<{
    name: string;
    url?: string;
  }>;
  topicHubs?: Array<{
    title: string;
    href: string;
    note: string;
  }>;
  relatedPosts?: Array<{
    title: string;
    url: string;
    date: string;
    category?: string;
    note?: string;
  }>;
};

const {
  title,
  seoTitle,
  description,
  price,
  platform,
  lizhiUrl,
  lizhiName,
  sources = [],
  quotes = [],
  officialUrl,
  updatedAt,
  faqs = [],
  date,
  categories = [],
  tags = [],
  quickTake,
  canonical,
  image,
  heroImage,
  heroWidth,
  heroHeight,
  structuredData,
  breadcrumbs = [],
  topicHubs = [],
  relatedPosts = []
} = Astro.props;
const introLine = quickTake?.trim() || description?.trim();
const metaTitle = seoTitle?.trim() || title;
const lastUpdated = (updatedAt ?? date).toISOString().slice(0, 10).replaceAll("-", ".");
const factItems = [
  price ? { label: "价格", value: price } : null,
  platform ? { label: "平台", value: platform } : null
].filter(Boolean) as Array<{ label: string; value: string }>;
---
<BaseLayout
  title={`${metaTitle} | MacAppHQ`}
  description={description}
  canonical={canonical}
  image={image}
  structuredData={structuredData}
  ogType="article"
>
  <section class="glass content article-shell">
    {breadcrumbs.length ? (
      <nav class="page-crumb article-crumb" aria-label="Breadcrumb">
        {breadcrumbs.map((item, index) => (
          <>
            {index > 0 ? <span aria-hidden="true">/</span> : null}
            {item.url ? <a href={item.url}>{item.name}</a> : <span>{item.name}</span>}
          </>
        ))}
      </nav>
    ) : null}
    <header class="article-header">
      <h1>{title}</h1>
      <div class="meta article-meta">
        <span class="article-meta__date">
          发布于 <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10).replaceAll("-", ".")}</time>
        </span>
        <span class="article-meta__author">
          作者：<a href="/author/">MacAppHQ 编辑部</a>
        </span>
        {categories.map((c) => (
          <a class="pill" href={`/category/${encodeURIComponent(c)}`}>{c}</a>
        ))}
      </div>
    </header>
    {introLine ? (
      <section class="article-intro" aria-label="文章导语">
        <h2 class="article-intro__title">这篇评测回答什么？</h2>
        <p>{introLine}</p>
      </section>
    ) : null}
    {heroImage ? (
      <figure class="article-hero">
        <img
          src={heroImage}
          alt={title}
          width={heroWidth}
          height={heroHeight}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    ) : null}
    {factItems.length ? (
      <section class="article-facts" aria-labelledby="article-facts-title">
        <h2 id="article-facts-title">关键信息</h2>
        <dl class="article-facts__grid">
          {factItems.map((fact) => (
            <div class="article-facts__item">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
          {officialUrl ? (
            <div class="article-facts__item">
              <dt>官网</dt>
              <dd><a href={officialUrl} rel="noopener noreferrer">访问官网</a></dd>
            </div>
          ) : null}
          <div class="article-facts__item">
            <dt>更新</dt>
            <dd>{lastUpdated}</dd>
          </div>
        </dl>
      </section>
    ) : null}
    <article class="article-prose">
      <slot />
      {lizhiUrl ? (
        <section class="article-partner" aria-label="正版购买">
          <a
            class="article-partner__link"
            href={lizhiUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
          >
            <span class="article-partner__brand">
              <span class="article-partner__label">正版购买</span>
              <img
                class="article-partner__logo"
                src="/media/partners/lizhi-logo.png"
                alt="数码荔枝"
                width="480"
                height="192"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="article-partner__copy">
              <strong>{lizhiName ? `购买 ${lizhiName} 正版授权` : "购买正版授权"}</strong>
              <span>在数码荔枝查看当前价格与授权活动</span>
            </span>
            <span class="article-partner__cta">
              查看价格
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </section>
      ) : null}
      {faqs.length ? (
        <section class="article-faq" aria-labelledby="article-faq-title">
          <h2 id="article-faq-title">常见问题有哪些？</h2>
          {faqs.map((item) => (
            <div class="article-faq__item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </section>
      ) : null}
      {sources.length || quotes.length ? (
        <section class="article-sources" aria-labelledby="article-sources-title">
          <h2 id="article-sources-title">资料来源与引用</h2>
          {quotes.map((quote) => (
            <figure class="article-quote">
              <blockquote>{quote.text}</blockquote>
              <figcaption>
                — <a href={quote.url} rel="noopener noreferrer">{quote.source}</a>
              </figcaption>
            </figure>
          ))}
          {sources.length ? (
            <ul>
              {sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">{source.name}</a>
                  {source.note ? `：${source.note}` : null}
                </li>
              ))}
            </ul>
          ) : null}
        </section>
      ) : null}
    </article>
  </section>
  {tags.length ? (
    <section class="glass article-extension-block" aria-label="相关主题">
      <div class="article-topics">
        <div class="article-extension-head">
          <h2>相关主题</h2>
          <p class="section-note">如果你想沿着同一个问题继续看，可以从这些主题继续往下读。</p>
        </div>
        <div class="article-topics__list">
          {tags.map((tag) => (
            <a class="pill" href={`/tag/${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      </div>
    </section>
  ) : null}
  {topicHubs.length ? (
    <section class="glass article-extension-block" aria-label="继续按主题阅读">
      <section class="article-hubs">
        <div class="article-extension-head">
          <h2>继续按主题往下看</h2>
          <p class="section-note">如果这篇文章已经对上你的问题，下一步更适合回到对应分类或专题继续看。</p>
        </div>
        <div class="search-results__list">
          {topicHubs.map((hub) => (
            <a class="search-result" href={hub.href}>
              <div class="search-result__meta">主题入口</div>
              <div class="search-result__title">{hub.title}</div>
              <p class="search-result__desc">{hub.note}</p>
            </a>
          ))}
        </div>
      </section>
    </section>
  ) : null}
  {relatedPosts.length ? (
    <section class="glass article-related-block" aria-label="相关文章">
      <section class="article-related">
        <div class="article-extension-head">
          <h2>相关文章</h2>
          <p class="section-note">如果你已经对这个方向感兴趣，下面这几篇通常更值得顺着读下去。</p>
        </div>
        <div class="article-related__list">
          {relatedPosts.map((post) => (
            <a class="article-related__item" href={post.url}>
              <div class="article-related__meta">
                {post.category ? <span>{post.category}</span> : null}
                <time datetime={post.date}>{post.date.slice(0, 10).replaceAll("-", ".")}</time>
              </div>
              <h3>{post.title}</h3>
              {post.note ? <p>{post.note}</p> : null}
            </a>
          ))}
        </div>
      </section>
    </section>
  ) : null}
</BaseLayout>
